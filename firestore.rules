rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sprawdzenie czy użytkownik jest zalogowany
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Sprawdzenie czy użytkownik jest właścicielem dokumentu
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Sprawdzenie czy dokument jest tworzony z poprawnymi danymi
    function hasValidEventData() {
      let data = request.resource.data;
      return data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0
        && data.description is string
        && data.date is timestamp
        && data.location is string && data.location.size() > 0
        && data.maxGuests is number && data.maxGuests > 0
        && data.status in ['active', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.guestCount is number
        && data.acceptedCount is number
        && data.pendingCount is number
        && data.declinedCount is number;
    }
    
    // Sprawdzenie czy aktualizacja dokumentu jest poprawna
    function hasValidEventUpdate() {
      let data = request.resource.data;
      return data.userId == resource.data.userId
        && (data.title is string && data.title.size() > 0)
        && (data.description is string)
        && (data.date is timestamp)
        && (data.location is string && data.location.size() > 0)
        && (data.maxGuests is number && data.maxGuests > 0)
        && (data.status in ['active', 'completed', 'cancelled']
            || (data.status == 'draft' && resource.data.status == 'draft'))
        && data.updatedAt is timestamp;
    }
    
    // Publiczna aktualizacja liczników RSVP (tylko pola statusów, bez guestCount)
    function isPublicRsvpEventCountUpdate() {
      let diff = request.resource.data.diff(resource.data);
      return !isAuthenticated()
        && diff.affectedKeys().hasOnly(['acceptedCount', 'pendingCount', 'declinedCount', 'maybeCount', 'updatedAt'])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.title == resource.data.title
        && request.resource.data.date == resource.data.date
        && request.resource.data.location == resource.data.location
        && request.resource.data.maxGuests == resource.data.maxGuests
        && request.resource.data.status == resource.data.status
        && request.resource.data.guestCount == resource.data.guestCount;
    }

    // Publiczny zapis odpowiedzi RSVP na dokumencie gościa (fallback bez Cloud Function)
    function isPublicRsvpGuestUpdate() {
      let diff = request.resource.data.diff(resource.data);
      let allowed = [
        'status', 'respondedAt', 'updatedAt', 'plusOneType', 'plusOneDetails',
        'dietaryRestrictions', 'eventSpecificNotes'
      ];
      return !isAuthenticated()
        && diff.affectedKeys().hasOnly(allowed)
        && request.resource.data.eventId == resource.data.eventId
        && request.resource.data.status in ['accepted', 'declined', 'maybe']
        && request.resource.data.respondedAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    // Wydarzenia
    match /events/{eventId} {
      // Pojedynczy odczyt — publiczny (strona RSVP dla gości bez konta)
      allow get: if true;
      allow list: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && hasValidEventData();
      allow update: if (isAuthenticated() && isOwner(resource.data.userId) && hasValidEventUpdate())
        || isPublicRsvpEventCountUpdate();
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Goście
    match /guests/{guestId} {
      // Odczyt - publiczny dostęp wymagany dla strony RSVP, ale tylko gdy istnieje ważny token RSVP
      allow get: if true;
      // Zapytania - tylko dla zalogowanych
      allow list: if isAuthenticated();
      
      allow create: if isAuthenticated() && (
        isOwner(request.resource.data.userId) ||
        exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
      );
      
      // Aktualizacja — organizator (zalogowany) lub publiczny RSVP (ograniczone pola).
      allow update: if isPublicRsvpGuestUpdate() || (
        isAuthenticated() && (
          isOwner(resource.data.userId) ||
          resource.data.email == request.auth.token.email ||
          (
            exists(/databases/$(database)/documents/events/$(resource.data.eventId)) &&
            get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.userId == request.auth.uid
          )
        )
      );
      
      allow delete: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        exists(/databases/$(database)/documents/events/$(resource.data.eventId)) &&
        get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.userId == request.auth.uid
      );
    }
    
    // Aktywności
    match /activities/{activityId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Użytkownicy — każdy może czytać/zmieniać wyłącznie własny profil
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Ustawienia użytkownika (powiadomienia, wygląd)
    match /userSettings/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Notyfikacje
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Analityki
    match /analytics/{analyticsId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Kontakty
    match /contacts/{contactId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Aktualizacja wyłącznie przez właściciela — RSVP (dieta/notatki) przez Cloud Function.
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Log wysyłek zaproszeń (zapis tylko przez Cloud Functions / Admin SDK)
    match /invitationLogs/{logId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create, update, delete: if false;
    }
    
    // Tokeny RSVP
    match /rsvpTokens/{tokenId} {
      // Odczyt tokenu po stringu (query where token==…) — publiczny, token jest sekretem w URL
      allow read: if true;
      
      // Tworzenie tokenu - tylko dla zalogowanych użytkowników
      allow create: if isAuthenticated() && (
        request.resource.data.eventGuestId is string &&
        request.resource.data.eventId is string &&
        request.resource.data.token is string &&
        request.resource.data.isUsed == false &&
        request.resource.data.createdAt is timestamp &&
        (request.resource.data.expiresAt is timestamp || request.resource.data.expiresAt == null)
      );
      
      // Aktualizacja tokenu - tylko zalogowany właściciel (organizator).
      // Tokeny są wielokrotnego użytku i nie są modyfikowane przez stronę publiczną,
      // dlatego publiczny zapis jest zablokowany.
      allow update: if isAuthenticated();
      
      // Usuwanie tokenów - tylko dla zalogowanych użytkowników
      allow delete: if isAuthenticated();
    }
  }
}
