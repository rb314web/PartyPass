# PartyPass Environment Variables

# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id

# EmailJS Configuration (fallback z klienta + formularz kontaktowy)
# Get these from https://www.emailjs.com/
REACT_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Formularz kontaktowy (np. template „Contact Us”)
REACT_APP_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id

# Zaproszenia RSVP — OSOBNY szablon (nie używaj Contact Us!)
# W EmailJS: Create New Template → To Email: {{to_email}}, Subject: {{subject}}
# Zmienne treści: {{to_name}}, {{event_title}}, {{event_date}}, {{event_location}},
# {{custom_message}}, {{rsvp_url}}, {{dresscode}}, {{additional_info}}
REACT_APP_EMAILJS_TEMPLATE_ID=your_invitation_template_id

# Powiadomienie dla organizatora po odpowiedzi gościa (RSVP)
# Szablon EmailJS: To Email {{to_email}}, Subject {{subject}}
# Zmienne: {{organizer_name}}, {{guest_name}}, {{guest_email}}, {{event_title}},
# {{event_date}}, {{status_badge}}, {{response_text}}, {{dietary_restrictions}},
# {{notes}}, {{plusOne}}, {{event_url}}, {{accepted_count}}, {{pending_count}}…
REACT_APP_EMAILJS_RSVP_TEMPLATE_ID=your_rsvp_notification_template_id

# EmailJS — zaproszenia przez Cloud Function (preferowane)
# firebase functions:config:set emailjs.service_id="..." emailjs.template_id="..." emailjs.public_key="..."
# firebase functions:config:set emailjs.invitation_template_id="..."
# firebase functions:config:set emailjs.rsvp_notification_template_id="..."
# firebase functions:config:set app.base_url="https://twoja-domena.pl"

# Application Settings
# Vite dev server (npm start) listens on port 3000 — same as CRA default.
REACT_APP_BASE_URL=http://localhost:3000

# Stripe Configuration (for payments)
REACT_APP_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# OpenWeatherMap (opcjonalne — bez klucza używany jest darmowy Open-Meteo)
# https://openweathermap.org/api
REACT_APP_OPENWEATHER_API_KEY=your_openweather_api_key
