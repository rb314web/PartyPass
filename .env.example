# PartyPass Environment Variables
#
# Vite loads both REACT_APP_* (legacy) and VITE_* (preferred for new vars).
# For Firebase keys you can use either prefix — see src/config/env.ts.

# --- Firebase (required) ---
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=your_measurement_id

# VITE_ aliases (optional — same values as above)
# VITE_FIREBASE_API_KEY=your_firebase_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id

# --- EmailJS (invitations + contact form) ---
# https://www.emailjs.com/
REACT_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
REACT_APP_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id
REACT_APP_EMAILJS_TEMPLATE_ID=your_invitation_template_id
REACT_APP_EMAILJS_RSVP_TEMPLATE_ID=your_rsvp_notification_template_id

# --- Google Analytics (optional — same ID as Firebase measurement) ---
REACT_APP_GA_TRACKING_ID=your_measurement_id
# VITE_GA_TRACKING_ID=your_measurement_id
# Falls back to REACT_APP_FIREBASE_MEASUREMENT_ID when unset
# VITE_BASE_URL=http://localhost:3000

# --- Payments (optional) ---
REACT_APP_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# --- Weather (optional — fallback: Open-Meteo) ---
REACT_APP_OPENWEATHER_API_KEY=your_openweather_api_key

# --- Cloudflare Turnstile (optional — contact form spam protection) ---
# https://developers.cloudflare.com/turnstile/
REACT_APP_TURNSTILE_SITE_KEY=your_turnstile_site_key
# Server-side verification (Cloud Functions / backend only — not exposed to browser):
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Cloud Functions (server-side EmailJS):
# firebase functions:config:set emailjs.service_id="..." emailjs.public_key="..."
# firebase functions:config:set app.base_url="https://your-domain.com"
